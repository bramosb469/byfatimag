<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Servicios - <%= config.nombre_negocio || 'Lu Cejas' %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@300;400;500;600;700&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css?v=8">
</head>
<body style="background-color: var(--color-bg);">
  
  <%- include('partials/header') %>

  <section class="page-hero text-center d-flex align-items-center justify-content-center">
    <div class="container fade-in-up">
      <h1 class="font-heading text-white display-4">Nuestros Servicios</h1>
      <div class="title-decorator bg-white mx-auto mt-4"></div>
    </div>
  </section>

  <section class="py-5 section-padding">
    <div class="container">
      <% if (servicios && servicios.length > 0) { %>
        <div class="row g-5 justify-content-center">
          <% servicios.forEach(servicio => { %>
          <div class="col-lg-4 col-md-6 fade-in-up">
            <div class="card service-card h-100 border-0 rounded-4 overflow-hidden shadow-sm">
              <div class="card-img-top service-img-placeholder" style="height: 250px;">
                <% if (servicio.imagen) { %>
                  <img src="<%= servicio.imagen %>" class="w-100 h-100" style="object-fit: cover;" alt="<%= servicio.nombre %>">
                <% } %>
              </div>
              <div class="card-body p-4 d-flex flex-column">
                <h3 class="font-heading mb-3 text-center"><%= servicio.nombre %></h3>
                <div class="d-flex justify-content-center align-items-center text-muted small mb-4 gap-3">
                  <span><i class="bi bi-clock me-1 text-primary-custom"></i> <%= servicio.duracion_min %> min</span>
                  <span class="fs-5 fw-bold text-primary-custom">$ <%= servicio.precio.toLocaleString('es-AR') %></span>
                </div>
                <p class="card-text text-muted mb-4 flex-grow-1 text-center"><%= servicio.descripcion %></p>
                <a href="/agendar?servicio=<%= servicio.id %>" class="btn btn-gold text-white rounded-pill w-100 py-2">Agendar este servicio</a>
              </div>
            </div>
          </div>
          <% }) %>
        </div>
      <% } else { %>
        <div class="text-center py-5 fade-in-up">
          <i class="bi bi-stars fs-1 text-primary-custom mb-3"></i>
          <h3 class="font-heading text-muted">Próximamente nuevos servicios</h3>
        </div>
      <% } %>
    </div>
  </section>

  <%- include('partials/footer') %>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
  <script src="/js/main.js?v=2"></script>
</body>
</html>
