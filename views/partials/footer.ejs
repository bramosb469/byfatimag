<footer class="footer py-5 mt-auto">
  <div class="gold-line-top"></div>
  <div class="container pt-4">
    <div class="row gy-4">
      <div class="col-lg-4 col-md-6">
        <h3 class="font-heading text-white mb-3"><%= config.nombre_negocio || 'LU CEJAS' %></h3>
        <p class="text-white-50"><%= config.slogan || 'Elegancia y perfección' %></p>
      </div>
      <div class="col-lg-4 col-md-6">
        <h5 class="font-heading text-white mb-3">Enlaces Rápidos</h5>
        <ul class="list-unstyled footer-links">
          <li><a href="/" class="text-white-50 text-decoration-none">Inicio</a></li>
          <li><a href="/servicios" class="text-white-50 text-decoration-none">Servicios</a></li>
          <li><a href="/galeria" class="text-white-50 text-decoration-none">Galería</a></li>
          <li><a href="/agendar" class="text-white-50 text-decoration-none">Agendar Turno</a></li>
        </ul>
      </div>
      <div class="col-lg-4 col-md-12">
        <h5 class="font-heading text-white mb-3">Contacto</h5>
        <ul class="list-unstyled text-white-50 mb-4 contact-info">
          <% if (config.direccion) { %><li class="mb-2"><i class="bi bi-geo-alt me-2 text-primary-custom"></i><%= config.direccion %></li><% } %>
          <% if (config.telefono) { %><li class="mb-2"><i class="bi bi-telephone me-2 text-primary-custom"></i><a href="tel:<%= config.telefono %>" class="text-white-50 text-decoration-none"><%= config.telefono %></a></li><% } %>
          <% if (config.email) { %><li class="mb-2"><i class="bi bi-envelope me-2 text-primary-custom"></i><a href="mailto:<%= config.email %>" class="text-white-50 text-decoration-none"><%= config.email %></a></li><% } %>
          <% if (config.instagram) { 
               let ig = config.instagram.trim();
               if (!ig.startsWith('http')) {
                 if (ig.startsWith('www.')) ig = 'https://' + ig;
                 else ig = 'https://instagram.com/' + ig.replace(/^@/, '');
               }
          %>
          <li class="mb-2"><i class="bi bi-instagram me-2 text-primary-custom"></i><a href="<%= ig %>" target="_blank" class="text-white-50 text-decoration-none">Instagram</a></li>
          <% } %>
        </ul>
      </div>
    </div>
    
    <div class="row mt-4 border-top border-secondary pt-4">
      <div class="col-12">
        <h6 class="text-white font-heading mb-3">Horarios de Atención</h6>
        <div class="d-flex flex-wrap text-white-50 small gap-3">
          <div><strong class="text-white">Lun:</strong> <%= config.horario_lunes || 'Cerrado' %></div>
          <div><strong class="text-white">Mar:</strong> <%= config.horario_martes || 'Cerrado' %></div>
          <div><strong class="text-white">Mié:</strong> <%= config.horario_miercoles || 'Cerrado' %></div>
          <div><strong class="text-white">Jue:</strong> <%= config.horario_jueves || 'Cerrado' %></div>
          <div><strong class="text-white">Vie:</strong> <%= config.horario_viernes || 'Cerrado' %></div>
          <div><strong class="text-white">Sáb:</strong> <%= config.horario_sabado || 'Cerrado' %></div>
          <div><strong class="text-white">Dom:</strong> <%= config.horario_domingo || 'Cerrado' %></div>
        </div>
      </div>
    </div>
    
    <div class="row mt-5">
      <div class="col-12 text-center text-white-50 small">
        <%= config.footer_texto || ('© ' + new Date().getFullYear() + ' ' + (config.nombre_negocio || 'LU CEJAS') + '. Todos los derechos reservados.') %>
      </div>
    </div>
  </div>
</footer>
