<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Gestión de Turnos - Panel de Control</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;600&family=Inter:wght@300;400;600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/admin.css">
</head>
<body>
<div class="d-flex">
  <%- include('partials/sidebar', {currentPage: 'turnos'}) %>
  
  <main class="main-content flex-grow-1 p-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
      <h2>Gestión de Turnos</h2>
      <button class="btn btn-gold text-white" data-bs-toggle="modal" data-bs-target="#nuevoTurnoModal">
        <i class="bi bi-plus-lg"></i> Nuevo Turno
      </button>
    </div>

    <% if (typeof msg !== 'undefined' && msg === 'ok') { %>
      <div class="alert alert-success alert-dismissible fade show" role="alert">
        Operación realizada con éxito.
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
      </div>
    <% } %>

    <!-- Filtros -->
    <div class="card shadow-sm border-0 mb-4">
      <div class="card-body">
        <form action="/admin/turnos" method="GET" class="row g-3 align-items-end">
          <div class="col-md-2">
            <label class="form-label">Estado</label>
            <select name="estado" class="form-select">
              <option value="">Todos</option>
              <option value="pendiente" <%= (filters && filters.estado === 'pendiente') ? 'selected' : '' %>>Pendiente</option>
              <option value="confirmado" <%= (filters && filters.estado === 'confirmado') ? 'selected' : '' %>>Confirmado</option>
              <option value="completado" <%= (filters && filters.estado === 'completado') ? 'selected' : '' %>>Completado</option>
              <option value="cancelado" <%= (filters && filters.estado === 'cancelado') ? 'selected' : '' %>>Cancelado</option>
            </select>
          </div>
          <div class="col-md-3">
            <label class="form-label">Servicio</label>
            <select name="servicio_id" class="form-select">
              <option value="">Todos</option>
              <% if (servicios) { servicios.forEach(s => { %>
                <option value="<%= s.id %>" <%= (filters && filters.servicio_id == s.id) ? 'selected' : '' %>><%= s.nombre %></option>
              <% }) } %>
            </select>
          </div>
          <div class="col-md-2">
            <label class="form-label">Desde</label>
            <input type="date" name="fecha_desde" class="form-control" value="<%= (filters && filters.fecha_desde) ? filters.fecha_desde : '' %>">
          </div>
          <div class="col-md-2">
            <label class="form-label">Hasta</label>
            <input type="date" name="fecha_hasta" class="form-control" value="<%= (filters && filters.fecha_hasta) ? filters.fecha_hasta : '' %>">
          </div>
          <div class="col-md-3 d-flex gap-2">
            <button type="submit" class="btn btn-primary w-100"><i class="bi bi-filter"></i> Filtrar</button>
            <a href="/admin/turnos" class="btn btn-outline-secondary"><i class="bi bi-x-circle"></i></a>
          </div>
        </form>
      </div>
    </div>

    <!-- Tabla -->
    <div class="card shadow-sm border-0">
      <div class="card-body p-0">
        <div class="table-responsive">
          <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
              <tr>
                <th>Fecha</th>
                <th>Hora</th>
                <th>Cliente</th>
                <th>Contacto</th>
                <th>Servicio</th>
                <th>Estado</th>
                <th>Notas</th>
                <th class="text-end">Acciones</th>
              </tr>
            </thead>
            <tbody>
              <% if (turnos && turnos.length > 0) { %>
                <% turnos.forEach(t => { %>
                  <tr>
                    <td><%= t.fecha %></td>
                    <td><%= t.hora %></td>
                    <td class="fw-semibold"><%= t.nombre_cliente %></td>
                    <td>
                      <small class="d-block"><i class="bi bi-telephone text-muted"></i> <%= t.telefono %></small>
                      <% if (t.email) { %><small class="d-block text-muted"><i class="bi bi-envelope"></i> <%= t.email %></small><% } %>
                    </td>
                    <td><%= t.servicio_nombre %></td>
                    <td>
                      <% if (t.estado === 'pendiente') { %><span class="badge bg-warning text-dark">Pendiente</span>
                      <% } else if (t.estado === 'confirmado') { %><span class="badge bg-info text-dark">Confirmado</span>
                      <% } else if (t.estado === 'completado') { %><span class="badge bg-success">Completado</span>
                      <% } else if (t.estado === 'cancelado') { %><span class="badge bg-danger">Cancelado</span>
                      <% } else { %><span class="badge bg-secondary"><%= t.estado %></span><% } %>
                    </td>
                    <td><span class="text-truncate d-inline-block" style="max-width: 150px;" title="<%= t.notas %>"><%= t.notas || '-' %></span></td>
                    <td class="text-end">
                      <div class="dropdown">
                        <button class="btn btn-sm btn-light border dropdown-toggle" type="button" data-bs-toggle="dropdown">
                          Acción
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end shadow-sm">
                          <li>
                            <form action="/admin/turnos/<%= t.id %>/estado" method="POST">
                              <input type="hidden" name="estado" value="confirmado">
                              <button type="submit" class="dropdown-item <%= t.estado === 'confirmado' ? 'disabled' : '' %>"><i class="bi bi-check-lg text-info me-2"></i> Confirmar</button>
                            </form>
                          </li>
                          <li>
                            <form action="/admin/turnos/<%= t.id %>/estado" method="POST">
                              <input type="hidden" name="estado" value="completado">
                              <button type="submit" class="dropdown-item <%= t.estado === 'completado' ? 'disabled' : '' %>"><i class="bi bi-check-all text-success me-2"></i> Completar</button>
                            </form>
                          </li>
                          <li>
                            <form action="/admin/turnos/<%= t.id %>/estado" method="POST">
                              <input type="hidden" name="estado" value="cancelado">
                              <button type="submit" class="dropdown-item <%= t.estado === 'cancelado' ? 'disabled' : '' %>"><i class="bi bi-x-lg text-warning me-2"></i> Cancelar</button>
                            </form>
                          </li>
                          <li><hr class="dropdown-divider"></li>
                          <li>
                            <form action="/admin/turnos/<%= t.id %>/delete" method="POST" class="form-delete">
                              <button type="submit" class="dropdown-item text-danger"><i class="bi bi-trash me-2"></i> Eliminar</button>
                            </form>
                          </li>
                        </ul>
                      </div>
                    </td>
                  </tr>
                <% }) %>
              <% } else { %>
                <tr>
                  <td colspan="8" class="text-center py-4 text-muted">No se encontraron turnos.</td>
                </tr>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </main>
</div>

<!-- Modal Nuevo Turno -->
<div class="modal fade" id="nuevoTurnoModal" tabindex="-1">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">Nuevo Turno</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <form action="/admin/turnos/nuevo" method="POST">
        <div class="modal-body">
          <div class="mb-3">
            <label class="form-label">Cliente *</label>
            <input type="text" name="nombre_cliente" class="form-control" required>
          </div>
          <div class="mb-3">
            <label class="form-label">Teléfono *</label>
            <input type="text" name="telefono" class="form-control" required>
          </div>
          <div class="mb-3">
            <label class="form-label">Email</label>
            <input type="email" name="email" class="form-control">
          </div>
          <div class="mb-3">
            <label class="form-label">Servicio *</label>
            <select name="servicio_id" class="form-select" required>
              <option value="">Seleccione un servicio</option>
              <% if (servicios) { servicios.forEach(s => { %>
                <option value="<%= s.id %>"><%= s.nombre %></option>
              <% }) } %>
            </select>
          </div>
          <div class="row">
            <div class="col-md-6 mb-3">
              <label class="form-label">Fecha *</label>
              <input type="date" name="fecha" class="form-control" required>
            </div>
            <div class="col-md-6 mb-3">
              <label class="form-label">Hora *</label>
              <input type="time" name="hora" class="form-control" required>
            </div>
          </div>
          <div class="mb-3">
            <label class="form-label">Notas</label>
            <textarea name="notas" class="form-control" rows="2"></textarea>
          </div>
          <input type="hidden" name="estado" value="confirmado"> <!-- Default for admin created -->
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
          <button type="submit" class="btn btn-primary">Guardar Turno</button>
        </div>
      </form>
    </div>
  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script src="/js/admin.js"></script>
</body>
</html>
