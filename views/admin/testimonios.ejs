<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Gestión de Testimonios - Panel de Control</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;600&family=Inter:wght@300;400;600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/admin.css">
</head>
<body>
<div class="d-flex">
  <%- include('partials/sidebar', {currentPage: 'testimonios'}) %>
  
  <main class="main-content flex-grow-1 p-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
      <h2>Gestión de Testimonios</h2>
      <button class="btn btn-gold text-white" data-bs-toggle="modal" data-bs-target="#nuevoTestimonioModal">
        <i class="bi bi-plus-lg"></i> Agregar Testimonio
      </button>
    </div>

    <% if (typeof msg !== 'undefined' && msg === 'ok') { %>
      <div class="alert alert-success alert-dismissible fade show" role="alert">
        Operación realizada con éxito.
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
      </div>
    <% } %>

    <!-- Pendientes -->
    <h4 class="mb-3"><i class="bi bi-clock-history text-warning"></i> Pendientes de Aprobación</h4>
    <div class="row g-3 mb-5">
      <% const pendientes = testimonios ? testimonios.filter(t => !t.aprobado) : []; %>
      <% if (pendientes.length > 0) { %>
        <% pendientes.forEach(t => { %>
          <div class="col-md-6 col-lg-4">
            <div class="card shadow-sm border-warning border-opacity-50 h-100">
              <div class="card-body">
                <div class="d-flex justify-content-between mb-2">
                  <h5 class="card-title mb-0"><%= t.nombre_cliente %></h5>
                  <div class="text-warning">
                    <% for(let i=0; i<t.calificacion; i++) { %><i class="bi bi-star-fill"></i><% } %>
                  </div>
                </div>
                <p class="card-text text-muted small fst-italic">"<%= t.texto %>"</p>
                <div class="d-flex gap-2 mt-3">
                  <form action="/admin/testimonios/<%= t.id %>/aprobar" method="POST" class="flex-grow-1">
                    <button type="submit" class="btn btn-sm btn-success w-100"><i class="bi bi-check-lg"></i> Aprobar</button>
                  </form>
                  <form action="/admin/testimonios/<%= t.id %>/delete" method="POST" class="form-delete">
                    <button type="submit" class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></button>
                  </form>
                </div>
              </div>
            </div>
          </div>
        <% }) %>
      <% } else { %>
        <div class="col-12"><div class="alert alert-light text-muted">No hay testimonios pendientes.</div></div>
      <% } %>
    </div>

    <!-- Aprobados -->
    <h4 class="mb-3"><i class="bi bi-check-circle text-success"></i> Testimonios Aprobados</h4>
    <div class="card shadow-sm border-0">
      <div class="card-body p-0">
        <div class="table-responsive">
          <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
              <tr>
                <th>Fecha</th>
                <th>Cliente</th>
                <th>Calificación</th>
                <th>Testimonio</th>
                <th class="text-end">Acciones</th>
              </tr>
            </thead>
            <tbody>
              <% const aprobados = testimonios ? testimonios.filter(t => t.aprobado) : []; %>
              <% if (aprobados.length > 0) { %>
                <% aprobados.forEach(t => { %>
                  <tr>
                    <td class="text-muted small"><%= t.fecha || '-' %></td>
                    <td class="fw-semibold"><%= t.nombre_cliente %></td>
                    <td class="text-warning">
                      <% for(let i=0; i<t.calificacion; i++) { %><i class="bi bi-star-fill small"></i><% } %>
                    </td>
                    <td><span class="d-inline-block text-truncate fst-italic text-muted" style="max-width: 300px;">"<%= t.texto %>"</span></td>
                    <td class="text-end">
                      <div class="d-flex gap-2 justify-content-end">
                        <form action="/admin/testimonios/<%= t.id %>/rechazar" method="POST">
                          <button type="submit" class="btn btn-sm btn-outline-warning" title="Ocultar (Quitar aprobación)"><i class="bi bi-eye-slash"></i></button>
                        </form>
                        <form action="/admin/testimonios/<%= t.id %>/delete" method="POST" class="form-delete">
                          <button type="submit" class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></button>
                        </form>
                      </div>
                    </td>
                  </tr>
                <% }) %>
              <% } else { %>
                <tr><td colspan="5" class="text-center py-4 text-muted">No hay testimonios aprobados.</td></tr>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </main>
</div>

<!-- Modal Nuevo -->
<div class="modal fade" id="nuevoTestimonioModal" tabindex="-1">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">Agregar Testimonio Manual</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <form action="/admin/testimonios/nuevo" method="POST">
        <div class="modal-body">
          <div class="mb-3">
            <label class="form-label">Nombre del Cliente *</label>
            <input type="text" name="nombre_cliente" class="form-control" required>
          </div>
          <div class="mb-3">
            <label class="form-label">Calificación *</label>
            <select name="calificacion" class="form-select" required>
              <option value="5">5 Estrellas (Excelente)</option>
              <option value="4">4 Estrellas (Muy Bueno)</option>
              <option value="3">3 Estrellas (Bueno)</option>
              <option value="2">2 Estrellas (Regular)</option>
              <option value="1">1 Estrella (Malo)</option>
            </select>
          </div>
          <div class="mb-3">
            <label class="form-label">Testimonio *</label>
            <textarea name="texto" class="form-control" rows="4" required></textarea>
          </div>
          <input type="hidden" name="aprobado" value="1"> <!-- Auto approved if admin adds it -->
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
          <button type="submit" class="btn btn-primary">Agregar y Aprobar</button>
        </div>
      </form>
    </div>
  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script src="/js/admin.js"></script>
</body>
</html>
