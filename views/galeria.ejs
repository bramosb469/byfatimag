<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Galería - <%= config.nombre_negocio || 'Lu Cejas' %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@300;400;500;600;700&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css?v=8">
</head>
<body style="background-color: var(--color-bg);">
  
  <%- include('partials/header') %>

  <section class="page-hero text-center d-flex align-items-center justify-content-center">
    <div class="container fade-in-up">
      <h1 class="font-heading text-white display-4">Galería de Trabajos</h1>
      <div class="title-decorator bg-white mx-auto mt-4"></div>
    </div>
  </section>

  <section class="py-5 section-padding">
    <div class="container">
      <% if (items && items.length > 0) { %>
        
        <div class="d-flex justify-content-center flex-wrap gap-2 mb-5 fade-in-up">
          <button class="btn btn-outline-gold rounded-pill px-4 active gallery-filter-btn" data-filter="all">Todos</button>
          <% servicios.forEach(serv => { %>
            <button class="btn btn-outline-gold rounded-pill px-4 gallery-filter-btn" data-filter="<%= serv.id %>"><%= serv.nombre %></button>
          <% }) %>
        </div>

        <div class="gallery-masonry" id="galleryContainer">
          <% items.forEach(item => { %>
            <div class="gallery-item-masonry fade-in-up mb-4" data-servicio="<%= item.servicio_id %>">
              <div class="gallery-card position-relative rounded-4 overflow-hidden shadow-sm cursor-pointer" 
                   data-type="<%= item.tipo %>" 
                   data-url="<%= item.imagen_url %>" 
                   data-before="<%= item.antes_url || '' %>"
                   data-title="<%= item.titulo || '' %>"
                   onclick="openLightbox(this)">
                
                <% if (item.tipo === 'video') { %>
                  <img src="<%= item.thumbnail_url || item.imagen_url %>" alt="Video" class="w-100 img-fluid">
                  <div class="play-icon-overlay position-absolute top-50 start-50 translate-middle">
                    <i class="bi bi-play-circle-fill text-white fs-1"></i>
                  </div>
                <% } else { %>
                  <img src="<%= item.imagen_url %>" alt="Trabajo" class="w-100 img-fluid">
                <% } %>
                
                <% if (item.antes_url) { %>
                  <div class="position-absolute top-0 start-0 m-3 badge bg-primary-custom text-white rounded-pill px-3 py-2">
                    Antes / Después
                  </div>
                <% } %>
                
                <div class="gallery-overlay d-flex align-items-center justify-content-center text-center p-3">
                  <span class="text-white font-heading h5 mb-0"><%= item.titulo || 'Ver detalle' %></span>
                </div>
              </div>
            </div>
          <% }) %>
        </div>
      <% } else { %>
        <div class="text-center py-5 fade-in-up">
          <i class="bi bi-images fs-1 text-primary-custom mb-3"></i>
          <h3 class="font-heading text-muted">Próximamente compartiremos nuestros trabajos</h3>
        </div>
      <% } %>
    </div>
  </section>

  <!-- Lightbox Modal -->
  <div class="modal fade" id="lightboxModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered">
      <div class="modal-content bg-transparent border-0">
        <button type="button" class="btn-close btn-close-white position-absolute top-0 end-0 m-3 z-3" data-bs-dismiss="modal" aria-label="Close"></button>
        <div class="modal-body p-0 text-center">
          <div id="lightboxContent" class="d-flex justify-content-center align-items-center flex-column flex-md-row gap-3">
            <!-- Content injected via JS -->
          </div>
          <h4 id="lightboxTitle" class="text-white font-heading mt-3 mb-0"></h4>
        </div>
      </div>
    </div>
  </div>

  <%- include('partials/footer') %>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
  <script src="/js/main.js?v=2"></script>
</body>
</html>
