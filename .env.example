# Copia este archivo a .env para desarrollo local. En Vercel, cargalas en
# Settings -> Environment Variables.

# Supabase -> Project Settings -> Database -> Connection string -> "Transaction pooler" (puerto 6543)
DATABASE_URL=postgresql://postgres.xxxxx:TU_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres

# Supabase -> Project Settings -> API
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=tu_service_role_key
# Nombre del bucket publico creado en Storage (por defecto: uploads)
SUPABASE_BUCKET=uploads

# Administrador inicial y firma de sesion
ADMIN_EMAIL=admin@lucejas.com
ADMIN_PASSWORD=cambia-esta-clave
SESSION_SECRET=un-texto-largo-y-aleatorio
